        "expression": "probe_m*sphere_gravity*(-6.67430e-11*sphere_m/max(r,sphere_R)+6.67430e-11*sphere_m*(min(r,sphere_R)^2-sphere_R^2)/(2*max(sphere_R,1e-30)^3))",

{
  "name": "model-studio",
  "version": "2.3.0",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "test": "node --test tools/*.test.mjs",
    "build:theme": "node tools/build-theme.mjs",
    "check:gallery": "node tools/check-gallery.mjs",
    "build:science": "node tools/build-science.mjs",
    "check:science": "node tools/science-benchmark.mjs",
    "desktop": "electron .",
    "package:desktop": "node tools/package-desktop.mjs",
    "test:browser": "playwright test",
    "test:desktop": "playwright test --config playwright.desktop.config.mjs",
    "start:web": "node server.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "description": "Локальная лаборатория интерактивных моделей по физике и математике",
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@observablehq/plot": "0.6.17",
    "@playwright/test": "1.64.0",
    "electron": "44.7.0",
    "esbuild": "0.25.12",
    "papaparse": "5.7.0",
    "simple-statistics": "7.12.1"
  },
  "main": "desktop/main.mjs",
  "productName": "Модельная",
  "packageManager": "pnpm@11.25.0"
}
